{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "title": "Widening Inequality Gap",
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/fengfoo/2179/refs/heads/main/data/hh_income.csv" 
      },
      "mark": {
        "type": "line", 
        "point": {"filled": true, "size": 60}, 
        "color": "#0072B2"
      },
      "encoding": {
        "x": {
          "field": "income_median", 
          "type": "quantitative",
          "title": "Median Income (Malaysian Ringgit)",
          "scale": {"zero": false}
        },
        "y": {
          "field": "income_mean", 
          "type": "quantitative",
          "title": "Mean Income (RM)",
          "scale": {"zero": false}
        },
        "order": {"field": "date", "type": "temporal"},
        "tooltip": [
          {"field": "date", "timeUnit": "year", "title": "Year"},
          {"field": "income_mean", "title": "Mean (RM)", "format": ",.0f"},
          {"field": "income_median", "title": "Median (RM)", "format": ",.0f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"x": 5200, "y": 7400, "label": "2020 Pandemic Drop"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -15,
        "dy": -5,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#D55E00"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
