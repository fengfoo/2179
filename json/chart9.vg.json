{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "State Poverty vs National Wealth Trajectory",
  "width": "container",
  "height": 300,
  "params": [
    {
      "name": "State_selection",
      "value": "Perak",
      "bind": {
        "input": "select",
        "options": ["Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan", "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak", "Selangor", "Terengganu", "W.P. Kuala Lumpur", "W.P. Labuan", "W.P. Putrajaya"],
        "name": "Select State: "
      }
    }
  ],
  "data": {
    "url": "data/hh_poverty_state.csv"
  },
  "transform": [
    {"filter": "datum.state == State_selection"},
    {"calculate": "substring(datum.date, 0, 4)", "as": "Year_String"},
    {"calculate": "datetime(datum.Year_String, 0, 1)", "as": "Year_Parsed"},
    {
      "lookup": "Year_String",
      "from": {
        "data": {"url": "data/worldbank_my_long.csv"},
        "key": "Year",
        "fields": ["Income"]
      }
    },
    {"filter": "datum.Income != null && datum.poverty_absolute != null"}
  ],
  "layer": [
    {
      "mark": {
        "type": "line", 
        "color": "#D55E00", 
        "strokeWidth": 2, 
        "point": {"filled": true, "fill": "#4E79A7", "size": 60, "opacity": 1}
      },
      "encoding": {
        "x": {
          "field": "Income",
          "type": "quantitative",
          "title": "National Income per Capita (US$)",
          "scale": {"zero": true}
        },
        "y": {
          "field": "poverty_absolute",
          "type": "quantitative",
          "title": "State Absolute Poverty (%)"
        },
        "order": {
          "field": "Year_Parsed",
          "type": "temporal"
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "Year_String", "title": "Year"},
          {"field": "Income", "title": "National Income (US$)", "format": ",.0f"},
          {"field": "poverty_absolute", "title": "Absolute Poverty (%)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.Year_String == '1970' || datum.Year_String == '2020'"}
      ],
      "mark": {
        "type": "text", 
        "align": "left", 
        "dx": 8, 
        "dy": -8, 
        "fontWeight": "bold", 
        "color": "#0072B2"
      },
      "encoding": {
        "x": {"field": "Income", "type": "quantitative"},
        "y": {"field": "poverty_absolute", "type": "quantitative"},
        "text": {"field": "Year_String"}
      }
    }
  ],
  "config": {
    "title": { "font": "Arial, Helvetica, sans-serif", "offset": 20 },
    "axis": { "labelFont": "Arial, Helvetica, sans-serif", "titleFont": "Arial, Helvetica, sans-serif" },
    "text": { "font": "Arial, Helvetica, sans-serif" }
  }
}
