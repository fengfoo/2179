{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "National Wealth vs State Absolute Poverty",
    "offset": 30
  },
  "width": "container",
  "params": [
    {
      "name": "State_selection",
      "value": "Sabah",
      "bind": {
        "input": "select",
        "options": ["Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan", "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak", "Selangor", "Terengganu", "W.P. Kuala Lumpur", "W.P. Labuan", "W.P. Putrajaya"],
        "name": "Select State: "
      }
    }
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 130,
      "data": {"url": "https://raw.githubusercontent.com/fengfoo/2179/refs/heads/main/data/worldbank_my_long.csv"},
      "mark": {"type": "line", "color": "#0072B2", "strokeWidth": 2, "point": true},
      "encoding": {
        "x": {"field": "Year", "type": "temporal", "title": null, "axis": {"labels": false, "ticks": false}},
        "y": {"field": "Income", "type": "quantitative", "title": "Income (US$)", "scale": {"zero": false}},
        "tooltip": [{"field": "Year", "timeUnit": "year", "title": "Year"}, {"field": "Income", "title": "Income (US$)"}]
      }
    },
    {
      "width": "container",
      "height": 130,
      "data": {"url": "https://raw.githubusercontent.com/fengfoo/2179/refs/heads/main/data/hh_poverty_state.csv"},
      "transform": [
        {"filter": "datum.state == State_selection"},
        {"calculate": "datetime(substring(datum.date, 0, 4), 0, 1)", "as": "Year_Parsed"}
      ],
      "mark": {"type": "line", "color": "#D55E00", "strokeWidth": 3, "point": true},
      "encoding": {
        "x": {"field": "Year_Parsed", "type": "temporal", "title": "Year", "axis": {"grid": false}},
        "y": {"field": "poverty_absolute", "type": "quantitative", "title": "Poverty (%)"},
        "tooltip": [{"field": "state", "title": "State"}, {"field": "Year_Parsed", "timeUnit": "year", "title": "Year"}, {"field": "poverty_absolute", "title": "Poverty (%)"}]
      }
    }
  ],
  "config": {
    "title": { "font": "Arial, Helvetica, sans-serif" },
    "axis": { "labelFont": "Arial, Helvetica, sans-serif", "titleFont": "Arial, Helvetica, sans-serif" },
    "legend": { "labelFont": "Arial, Helvetica, sans-serif", "titleFont": "Arial, Helvetica, sans-serif" },
    "text": { "font": "Arial, Helvetica, sans-serif" }
  }
}
