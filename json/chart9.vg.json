{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "National Wealth vs State Absolute Poverty",
  "width": "container",
  "height": 300,
  "resolve": {"scale": {"y": "independent"}},
  "params": [
    {
      "name": "State_selection",
      "value": "Sabah",
      "bind": {
        "input": "select",
        "options": ["Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan", "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak", "Selangor", "Terengganu", "W.P. Kuala Lumpur", "W.P. Labuan", "W.P. Putrajaya"],
        "name": "Select State: "
      }
    }
  ],
  "layer": [
    {
      "data": {"url": "https://raw.githubusercontent.com/fengfoo/2179/refs/heads/main/data/worldbank_my_long.csv"},
      "mark": {"type": "area", "color": "#56B4E9", "opacity": 0.3},
      "encoding": {
        "x": {"field": "Year", "type": "temporal", "title": "Year", "axis": {"grid": false}},
        "y": {"field": "Income", "type": "quantitative", "title": "National Income (US$)"}
      }
    },
    {
      "data": {"url": "data/worldbank_my_long.csv"},
      "mark": {"type": "line", "color": "#0072B2", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "Year", "type": "temporal"},
        "y": {
          "field": "Income", 
          "type": "quantitative",
          "axis": null 
        }
      }
    },
    {
      "data": {"url": "https://raw.githubusercontent.com/fengfoo/2179/refs/heads/main/data/hh_poverty_state.csv"},
      "transform": [
        {"filter": "datum.state == State_selection"},
        {"calculate": "datetime(substring(datum.date, 0, 4), 0, 1)", "as": "Year_Parsed"}
      ],
      "mark": {"type": "line", "color": "#D55E00", "strokeWidth": 3, "point": true},
      "encoding": {
        "x": {"field": "Year_Parsed", "type": "temporal"},
        "y": {
          "field": "poverty_absolute", 
          "type": "quantitative", 
          "title": "Absolute Poverty (%)"
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "Year_Parsed", "timeUnit": "year", "title": "Year"},
          {"field": "poverty_absolute", "title": "Absolute Poverty (%)"}
        ]
      }
    },
    {
      "data": {
        "values": [{"Year_Parsed": "2020-01-01"}]
      },
      "mark": {"type": "rule", "color": "#D55E00", "strokeDash": [4, 4], "size": 1.5},
      "encoding": {
        "x": {"field": "Year_Parsed", "type": "temporal"}
      }
    },
    {
      "data": {
        "values": [{"Year_Parsed": "2020-01-01", "label": "2020 COVID-19 Shock"}]
      },
      "mark": {"type": "text", "align": "right", "dx": -5, "dy": -120, "fontSize": 11, "fontWeight": "bold", "color": "#D55E00"},
      "encoding": {
        "x": {"field": "Year_Parsed", "type": "temporal"},
        "text": {"field": "label"}
      }
    }
  ]
}