{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "title": "National Income Accumulation",
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/fengfoo/2179/refs/heads/main/data/worldbank_my_long.csv"
      },
      "transform": [
        {
          "window": [{"op": "lag", "field": "Income", "as": "Previous_Income"}],
          "sort": [{"field": "Year"}]
        },
        {"filter": "datum.Previous_Income != null"},
        {"calculate": "datum.Income - datum.Previous_Income", "as": "Diff"}
      ],
      "mark": {"type": "bar", "stroke": "black", "strokeWidth": 0.5},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal", "title": "Year", "axis": {"labelAngle": -90, "labelOverlap": true}},
        "y": {
          "field": "Previous_Income", 
          "type": "quantitative", 
          "title": "Income (US$)", 
          "scale": {"zero": false}
        },
        "y2": {"field": "Income"},
        "color": {
          "condition": {"test": "datum.Diff > 0", "value": "#0072B2"},
          "value": "#D55E00"
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "Income", "type": "quantitative", "title": "Total (US$)", "format": ",.0f"},
          {"field": "Diff", "type": "quantitative", "title": "Net Change", "format": "+,.0f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"Year": "1971"},
          {"Year": "1998"},
          {"Year": "2020"}
        ]
      },
      "mark": {"type": "rule", "color": "#333", "strokeDash": [4, 4], "size": 1.5},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"}
      }
    },
    {
      "data": {
        "values": [
          {"Year": "1971", "label": "1971: New Economic Policy Launched", "align": "left", "dx": 5},
          {"Year": "1998", "label": "1998: Asian Financial Crisis", "align": "right", "dx": -5},
          {"Year": "2020", "label": "2020: COVID-19 Pandemic", "align": "left", "dx": 5}
        ]
      },
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "color": "#333"},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"value": -15},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "title": { "font": "Arial, Helvetica, sans-serif", "offset": 40 },
    "axis": { "labelFont": "Arial, Helvetica, sans-serif", "titleFont": "Arial, Helvetica, sans-serif" },
    "legend": { "labelFont": "Arial, Helvetica, sans-serif", "titleFont": "Arial, Helvetica, sans-serif" },
    "text": { "font": "Arial, Helvetica, sans-serif" }
  }
}
