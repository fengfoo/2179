{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "title": {"text": "The Expanding Income Gap"},
  "data": {
    "url": "data/hh_income.csv"
  },
  "layer": [
    {
      "mark": {"type": "area", "color": "#D55E00", "opacity": 0.2},
      "encoding": {
        "x": {
          "field": "date", 
          "type": "temporal",
          "title": "Year",
          "axis": {"grid": false}
        },
        "y": {"field": "income_median", "type": "quantitative"},
        "y2": {"field": "income_mean"},
        "tooltip": [
          {"field": "date", "timeUnit": "year", "title": "Year"},
          {"field": "income_mean", "title": "Mean (MYR)", "format": ",.0f"},
          {"field": "income_median", "title": "Median (MYR)", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {"type": "line", "color": "#0072B2", "size": 2.5},
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {
          "field": "income_mean",
          "type": "quantitative",
          "title": "Income (Malaysian Ringgit)",
          "axis": {"gridColor": "#f0f0f0", "gridDash": [4, 4]}
        }
      }
    },
    {
      "mark": {"type": "line", "color": "#D55E00", "size": 2.5, "strokeDash": [5, 5]},
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"field": "income_median", "type": "quantitative"}
      }
    },
    {
      "data": {
        "values": [
          {"date": "1971-01-01"},
          {"date": "1998-01-01"},
          {"date": "2020-01-01"}
        ]
      },
      "mark": {"type": "rule", "color": "#888", "strokeDash": [3, 3]},
      "encoding": {"x": {"field": "date", "type": "temporal"}}
    },
    {
      "data": {"values": [{"date": "1971-01-01"}]},
      "mark": {"type": "text", "align": "left", "dx": 5, "fontWeight": "bold", "fontSize": 11, "color": "#555"},
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"value": -10},
        "text": {"value": "1971: New Economic Policy Launched"}
      }
    },
    {
      "data": {"values": [{"date": "1998-01-01"}]},
      "mark": {"type": "text", "align": "center", "dx": 5, "fontWeight": "bold", "fontSize": 11, "color": "#555"},
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"value": -20},
        "text": {"value": "1998: Asian Financial Crisis"}
      }
    },
    {
      "data": {"values": [{"date": "2020-01-01"}]},
      "mark": {"type": "text", "align": "right", "dx": -5, "fontWeight": "bold", "fontSize": 11, "color": "#555"},
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"value": -10},
        "text": {"value": "2020: COVID-19 Pandemic"}
      }
    }
  ],
  "config": {
    "title": { "font": "Arial, Helvetica, sans-serif", "offset": 45 },
    "axis": { "labelFont": "Arial, Helvetica, sans-serif", "titleFont": "Arial, Helvetica, sans-serif" },
    "legend": { "labelFont": "Arial, Helvetica, sans-serif", "titleFont": "Arial, Helvetica, sans-serif" },
    "text": { "font": "Arial, Helvetica, sans-serif" }
  }
}
